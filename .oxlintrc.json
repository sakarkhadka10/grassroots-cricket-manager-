{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["react-perf", "jsx-a11y", "nextjs", "typescript", "unicorn", "oxc"],
  "categories": {
    "correctness": "error",
    "suspicious": "warn"
  },
  "ignorePatterns": [".next/**", "out/**", "build/**", "coverage/**", "node_modules/**"],
  "rules": {},
  "env": {
    "builtin": true
  }
}
